{
  "expo": {
    "name": "Vega",
    "slug": "vegachat",
    "version": "2.3.0",
    "orientation": "portrait",
    "icon": "./assets/notebook.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/notebook.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.Turdiyev.vegaChat",
      "buildNumber": "2.0.0"
    },
    "android": {
      "package": "com.Turdiyev.vegaChat",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/notebook.png",
        "backgroundColor": "#6651A8"
      }
    },
    "web": {
      "favicon": "./assets/notebook.png"
    },
    "extra": {
      "eas": {
        "projectId": "82b5651f-d6cf-49c3-bd7c-af2d5d40a830"
      }
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
